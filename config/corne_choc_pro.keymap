#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/unicode.dtsi>
#include <zmk-unicode/keys-extra.h>  // All glyphs except CJK
#include <zmk-helpers/helper.h>

// Layer indices, referenced by name from &lt/&mo/&to bindings below instead of
// as raw numbers, so inserting/reordering a layer doesn't silently renumber
// every reference to the layers that follow it.
#define DEFAULT    0
#define SYMBOL     1
#define GREEK      2
#define NAVIGATION 3
#define FUNCTION   4
#define DIACRITICS 5
#define ACCENT     6

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

&uc {
  default-mode = <UC_MODE_LINUX>;  // Default to Linux input system
};


// tap: comma | shift + tap: semicolon 
ZMK_BEHAVIOR(COMMA_OPT, mod_morph,
    bindings = <&kp COMMA>, <&kp SEMICOLON>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

// tap: dot | shift + tap: colon 
ZMK_BEHAVIOR(DOT_OPT, mod_morph,
    bindings = <&kp DOT>, <&kp COLON>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

// ?!
// tap: question mark | shift + tap exclamation mark
ZMK_BEHAVIOR(QMARK_OPT, mod_morph,
    bindings = <&kp QMARK>, <&kp EXCL>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)


// '`"
// tap: ' alt + tap: " (base for nesting)
ZMK_BEHAVIOR(SINGLEDOUBLE, mod_morph,
    bindings = <&kp SQT>, <&kp DQT>;
    mods = <(MOD_LALT|MOD_RALT)>;
)
// tap: ' (or " on alt) | shift + tap: `
ZMK_BEHAVIOR(QUOT_OPT, mod_morph,
    bindings = <&SINGLEDOUBLE>, <&kp GRAVE>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)


// /\|
// tap: slash alt + tap: pipe (base for nesting)
ZMK_BEHAVIOR(SLASHPIPE, mod_morph,
    bindings = <&kp SLASH>, <&kp PIPE>;
    mods = <(MOD_LALT|MOD_RALT)>;
)
// tap: slash (or pipe on alt) | shift + tap: backslash
ZMK_BEHAVIOR(SLSH_OPT, mod_morph,
    bindings = <&SLASHPIPE>, <&kp BACKSLASH>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)


// -_~
// tap: - alt + tap: ~ (base for nesting)
ZMK_BEHAVIOR(DASHTILDE, mod_morph,
    bindings = <&kp MINUS>, <&kp TILDE>;
    mods = <(MOD_LALT|MOD_RALT)>;
)
// tap: - (or ~ on alt) | shift + tap: _
ZMK_BEHAVIOR(DASH_OPT, mod_morph,
    bindings = <&DASHTILDE>, <&kp UNDERSCORE>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)


// <⟨«
// tap: < alt + tap: ⟨ (base for nesting)
ZMK_BEHAVIOR(LTANGLE, mod_morph,
    bindings = <&kp LT>, <&uc UC_MATHEMATICAL_LEFT_ANGLE_BRACKET>;
    mods = <(MOD_LALT|MOD_RALT)>;
)
// tap: < (or ⟨ on alt) | shift + tap: «
ZMK_BEHAVIOR(LT_OPT, mod_morph,
    bindings = <&LTANGLE>, <&uc UC_LEFT_POINTING_DOUBLE_ANGLE_QUOTATION_MARK>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

// >⟩»
// tap: > alt + tap: ⟩ (base for nesting)
ZMK_BEHAVIOR(GTANGLE, mod_morph,
    bindings = <&kp GT>, <&uc UC_MATHEMATICAL_RIGHT_ANGLE_BRACKET>;
    mods = <(MOD_LALT|MOD_RALT)>;
)
// tap: > (or ⟩ on alt) | shift + tap: »
ZMK_BEHAVIOR(GT_OPT, mod_morph,
    bindings = <&GTANGLE>, <&uc UC_RIGHT_POINTING_DOUBLE_ANGLE_QUOTATION_MARK>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

// *×†
// tap: * alt + tap: × (base for nesting)
ZMK_BEHAVIOR(STARTIMES, mod_morph,
    bindings = <&kp STAR>, <&uc UC_MULTIPLICATION_SIGN>;
    mods = <(MOD_LALT|MOD_RALT)>;
)
// tap: * (or × on alt) | shift + tap: † (dagger)
ZMK_BEHAVIOR(STAR_OPT, mod_morph,
    bindings = <&STARTIMES>, <&uc UC_DAGGER>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

// +±
// tap: + | shift + tap: ±
ZMK_BEHAVIOR(PLUS_OPT, mod_morph,
    bindings = <&kp PLUS>, <&uc UC_PLUS_MINUS_SIGN>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

// =≠≈
// tap: = alt + tap: ≈ (base for nesting)
ZMK_BEHAVIOR(EQUALAPPROX, mod_morph,
    bindings = <&kp EQUAL>, <&uc UC_ALMOST_EQUAL_TO>;
    mods = <(MOD_LALT|MOD_RALT)>;
)
// tap: = (or ≈ on alt) | shift + tap: ≠
ZMK_BEHAVIOR(EQUAL_OPT, mod_morph,
    bindings = <&EQUALAPPROX>, <&uc UC_NOT_EQUAL_TO>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
)

// Combining diacritical marks (U+0300 block) for the ACCENT layer. Not in
// zmk-unicode's generated headers (it only ships precomposed characters), so
// defined here directly the same way the Greek macros are: raw codepoints,
// same value in both slots since these have no separate shifted form. Typed
// *after* a base letter, they compose visually onto whatever precedes them,
// so they work on any letter instead of only the ones with a precomposed
// Unicode codepoint.
#define UC_COMB_CIRCUMFLEX 0x0302 0x0302 // ◌̂
#define UC_COMB_DIAERESIS  0x0308 0x0308 // ◌̈
#define UC_COMB_GRAVE      0x0300 0x0300 // ◌̀
#define UC_COMB_ACUTE      0x0301 0x0301 // ◌́
#define UC_COMB_TILDE      0x0303 0x0303 // ◌̃
#define UC_COMB_MACRON     0x0304 0x0304 // ◌̄
#define UC_COMB_CEDILLA    0x0327 0x0327 // ◌̧
#define UC_COMB_CARON      0x030C 0x030C // ◌̌
#define UC_COMB_DOT_ABOVE  0x0307 0x0307 // ◌̇

// Precomposed circumflex letters beyond the French vowels (already covered by
// zmk-unicode's UC_FR_{A,E,I,O,U}_CIRCUMFLEX): Esperanto's full circumflexed
// consonant set plus Welsh/Bantu-transliteration ones. Verified against
// Python's unicodedata — of the 26 Latin letters, only these 13 (plus AEIOU)
// have a precomposed circumflex codepoint at all; the rest have none, which
// is the whole reason the ACCENT layer's combining-mark keys exist.
#define UC_G_CIRCUMFLEX 0x011D 0x011C // ĝ/Ĝ
#define UC_H_CIRCUMFLEX 0x0125 0x0124 // ĥ/Ĥ
#define UC_J_CIRCUMFLEX 0x0135 0x0134 // ĵ/Ĵ
#define UC_S_CIRCUMFLEX 0x015D 0x015C // ŝ/Ŝ
#define UC_W_CIRCUMFLEX 0x0175 0x0174 // ŵ/Ŵ
#define UC_Y_CIRCUMFLEX 0x0177 0x0176 // ŷ/Ŷ
#define UC_Z_CIRCUMFLEX 0x1E91 0x1E90 // ẑ/Ẑ

// Precomposed diaeresis letters not covered by zmk-unicode's french.h (which
// only defines the ones French actually uses: E/I/U/Y). A and O have no
// French use either but do have Unicode codepoints (ä, ö); H and W are
// transliteration letters. Of the 12 ACCENT-layer circumflex letters, only
// these 4 plus E/I/U/Y (already in french.h) have a diaeresis counterpart --
// G/J/S/Z don't have one in Unicode at all, same story as the circumflex
// gaps above.
#define UC_A_DIAERESIS 0x00E4 0x00C4 // ä/Ä
#define UC_H_DIAERESIS 0x1E27 0x1E26 // ḧ/Ḧ
#define UC_O_DIAERESIS 0x00F6 0x00D6 // ö/Ö
#define UC_W_DIAERESIS 0x1E85 0x1E84 // ẅ/Ẅ

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <140>;
            quick-tap-ms = <100>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 37 38 39>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <140>;
            quick-tap-ms = <100>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 34 35 36>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
        c_ced: c_ced {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp C>, <&uc UC_FR_C_CEDILLA>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        e_hat: e_hat {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_FR_E_CIRCUMFLEX>, <&uc UC_FR_E_DIAERESIS>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        i_hat: i_hat {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_FR_I_CIRCUMFLEX>, <&uc UC_FR_I_DIAERESIS>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        u_hat: u_hat {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_FR_U_CIRCUMFLEX>, <&uc UC_FR_U_DIAERESIS>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        y_trema: y_trema {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp Y>, <&uc UC_FR_Y_DIAERESIS>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        a_hat: a_hat {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_FR_A_CIRCUMFLEX>, <&uc UC_A_DIAERESIS>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        o_hat: o_hat {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_FR_O_CIRCUMFLEX>, <&uc UC_O_DIAERESIS>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        h_hat: h_hat {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_H_CIRCUMFLEX>, <&uc UC_H_DIAERESIS>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        w_hat: w_hat {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_W_CIRCUMFLEX>, <&uc UC_W_DIAERESIS>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        y_hat: y_hat {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_Y_CIRCUMFLEX>, <&uc UC_FR_Y_DIAERESIS>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        theta_var: theta_var {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_EL_THETA>, <&uc UC_EL_THETA_SYM>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        phi_var: phi_var {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_EL_PHI>, <&uc UC_EL_PHI_SYM>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        epsilon_var: epsilon_var {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_EL_EPSILON>, <&uc UC_EL_EPSILON_SYM>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        kappa_var: kappa_var {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_EL_KAPPA>, <&uc UC_EL_KAPPA_SYM>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        pi_var: pi_var {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_EL_PI>, <&uc UC_EL_PI_SYM>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        rho_var: rho_var {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_EL_RHO>, <&uc UC_EL_RHO_SYM>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        sigma_var: sigma_var {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_EL_SIGMA>, <&uc UC_EL_FINAL_SIGMA>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        acc_circumflex_caron: acc_circumflex_caron {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_COMB_CIRCUMFLEX>, <&uc UC_COMB_CARON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        acc_macron_tilde: acc_macron_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_COMB_MACRON>, <&uc UC_COMB_TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        acc_dot_diaeresis: acc_dot_diaeresis {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&uc UC_COMB_DOT_ABOVE>, <&uc UC_COMB_DIAERESIS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
};
ZMK_BEHAVIOR(uc_upsilon, macro,
    bindings = <&uc UC_EL_UPSILON>;
)

ZMK_BEHAVIOR(uc_tau, macro,
    bindings = <&uc UC_EL_TAU>;
)

ZMK_BEHAVIOR(uc_iota, macro,
    bindings = <&uc UC_EL_IOTA>;
)

ZMK_BEHAVIOR(hm_upsilon, hold_tap,
    flavor = "balanced";
    tapping-term-ms = <140>;
    quick-tap-ms = <100>;
    bindings = <&kp>, <&uc_upsilon>;
    hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 37 38 39>;
    hold-trigger-on-release;
)

ZMK_BEHAVIOR(hm_tau, hold_tap,
    flavor = "balanced";
    tapping-term-ms = <140>;
    quick-tap-ms = <100>;
    bindings = <&kp>, <&uc_tau>;
    hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 34 35 36>;
    hold-trigger-on-release;
)

// Alt home-row mods for the greek layer, mirroring hml/hmr's I/R placement on the
// default layer, so the *_var alt-tap variants (theta_var, phi_var, ...) are reachable.
ZMK_BEHAVIOR(hm_iota, hold_tap,
    flavor = "balanced";
    tapping-term-ms = <140>;
    quick-tap-ms = <100>;
    bindings = <&kp>, <&uc_iota>;
    hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 37 38 39>;
    hold-trigger-on-release;
)

ZMK_BEHAVIOR(hm_rho, hold_tap,
    flavor = "balanced";
    tapping-term-ms = <140>;
    quick-tap-ms = <100>;
    bindings = <&kp>, <&rho_var>;
    hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 34 35 36>;
    hold-trigger-on-release;
)

// Shift/Alt home-row mods for the ACCENT layer, same U/T (shift) and I/R (alt)
// physical positions as the default and Greek layers, so Shift is reachable to
// get the caron/tilde/diaeresis shift-variants and uppercase letter forms, and
// Alt (redundantly, but consistently) to chord from either hand. U and I keep
// their existing u_hat/i_hat tap behavior; T and R had nothing bound there, so
// they're plain modifier keys, no hold-tap needed.
ZMK_BEHAVIOR(acc_hm_u, hold_tap,
    flavor = "balanced";
    tapping-term-ms = <140>;
    quick-tap-ms = <100>;
    bindings = <&kp>, <&u_hat>;
    hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 37 38 39>;
    hold-trigger-on-release;
)

ZMK_BEHAVIOR(acc_hm_i, hold_tap,
    flavor = "balanced";
    tapping-term-ms = <140>;
    quick-tap-ms = <100>;
    bindings = <&kp>, <&i_hat>;
    hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 37 38 39>;
    hold-trigger-on-release;
)

// Hold both home-row shift mods (U left / T right) together to toggle caps word.
// Short timeout + a prior-idle requirement keep it from misfiring during normal typing.
//
// ae/oe ligature combos: A+E and O+E, the literal component letters. These
// two are French-useful but don't conceptually belong on an "accent" layer,
// so they get their own combo instead, independent of whether the Diacritics
// layer (their current home) sticks around. A+E are two columns apart on the
// home row (different fingers, same shape as the combo above); O+E share a
// column (same finger, different row), which is a physically awkward
// simultaneous press, hence the longer timeout below to give that roll more
// slack.
/ {
    combos {
        compatible = "zmk,combos";
        combo_caps_word {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <18 23>;
            bindings = <&caps_word>;
            layers = <DEFAULT>;
        };
        combo_ae {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <15 17>;
            bindings = <&uc UC_FR_AE>;
            layers = <DEFAULT>;
        };
        combo_oe {
            timeout-ms = <80>;
            require-prior-idle-ms = <150>;
            key-positions = <3 17>;
            bindings = <&uc UC_FR_OE>;
            layers = <DEFAULT>;
        };
    };
};


/ {

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "OPTIMOT";

            // --------------------------------------------------------------------------------
            // |  ù   |  à  |  J  |  O  |  é  |  B  |  none |  none |  F  |  D  |  L   | '`" |  Q  |  X  |
            // | /\|  |  A  |  I  |  E  |  U  |  ,; |  none |  none |  P  |  T  |  S   |  R  |  N  |  ?! |
            // | -_~  |  K  |  Y  |  è  |  .: |  W  |               |  G  |  C  |  M   |  H  |  V  |  Z  |
            //                    | ESC | TAB |SPACE|               |BACKS|ENTER|→ACCENT|

            bindings = <
            &uc UC_FR_U_GRAVE &uc UC_FR_A_GRAVE &kp J       &kp O             &uc UC_FR_E_ACUTE &kp B      &none &none &kp F           &kp D              &kp L          &QUOT_OPT   &kp Q            &kp X
            &SLSH_OPT         &hml LGUI A       &hml LALT I &hml LCTRL E      &hml LSHFT U      &COMMA_OPT &none &none &kp P           &hmr RSHFT T       &hmr RCTRL S   &hmr LALT R &lt DIACRITICS N &QMARK_OPT
            &DASH_OPT         &kp K             &kp Y       &uc UC_FR_E_GRAVE &DOT_OPT          &kp W                  &kp G           &c_ced             &kp M          &kp H       &kp V            &kp Z
                                                            &lt FUNCTION ESC  &lt GREEK TAB     &kp SPACE              &lt SYMBOL BSPC &lt NAVIGATION RET &lt ACCENT DEL
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";

            // --------------------------------------------------------------------------------
            // |  n  |  %  |  &  |  $    |  ^   |  [   |  none |  none |  ]  |  7  |  8  |  9  |  #  |  n  |
            // | /\| |  √  | +±  | =≠≈   | *×†  |  (   |  none |  none |  )  |  4  |  5  |  6  |  0  |  n  |
            // |  n  |  @  | <⟨« | -_~   | >⟩»  |  {   |               |  }  |  1  |  2  |  3  |  .  |  ,  |
            //                   | ESC   | TAB  |SPACE |               | --- |ENTER| DEL |
            //
            // ^ (exponent/caret) swapped onto the $ key's old spot -- same physical
            // position as the Accent layer's circumflex, on the "e acute" key.

            bindings = <
            &none     &kp PRCNT          &kp AMPS  &kp DLLR   &kp CARET &kp LBKT  &none &none &kp RBKT &kp N7        &kp N8        &kp N9       &kp HASH &none
            &SLSH_OPT &uc UC_SQUARE_ROOT &PLUS_OPT &EQUAL_OPT &STAR_OPT &kp LPAR  &none &none &kp RPAR &hmr RSHFT N4 &hmr RCTRL N5 &hmr LALT N6 &kp N0   &none
            &none     &kp AT             &LT_OPT   &DASH_OPT  &GT_OPT   &kp LBRC              &kp RBRC &kp N1        &kp N2        &kp N3       &kp DOT  &kp COMMA
                                                   &kp ESC    &kp TAB   &kp SPACE             &none    &kp RET       &kp DEL
            >;
        };

        greek_layer {
            display-name = "GREEK";

            // --------------------------------------------------------------------------------
            // |  n  |  n  |  n  |omikr|theta| beta|  none |  none | phi |delta|lambd|  n |  n  |  xi |
            // |  n  |alpha|iota |epsil|upsil|  n  |  none |  none | pi  | tau |sigma|rho |  nu |  n  |
            // | psi |kappa|  n  |  n  |  n  |omega|               |gamma| chi | mu  |eta |  n  |zeta |
            //                   | ESC | --- |SPACE|               |BSPC |ENTER| DEL |

            bindings = <
            &none         &none           &none           &uc UC_EL_OMIKRON &theta_var          &uc UC_EL_BETA  &none &none &phi_var        &uc UC_EL_DELTA &uc UC_EL_LAMBDA &none          &none        &uc UC_EL_XI
            &none         &uc UC_EL_ALPHA &hm_iota LALT 0 &epsilon_var      &hm_upsilon LSHFT 0 &none           &none &none &pi_var         &hm_tau RSHFT 0 &sigma_var       &hm_rho RALT 0 &uc UC_EL_NU &none
            &uc UC_EL_PSI &kappa_var      &none           &none             &none               &uc UC_EL_OMEGA             &uc UC_EL_GAMMA &uc UC_EL_CHI   &uc UC_EL_MU     &uc UC_EL_ETA  &none        &uc UC_EL_ZETA
                                                          &kp ESC           &none               &kp SPACE                   &kp BSPC        &kp RET         &kp DEL
            >;
        };

        navigation_layer {
            display-name = "<^>";

            // --------------------------------------------------------------------------------
            // |  n  |  n  |snd -|snd x|snd +|paste|  none |  none |  n   |PgDn |  ^  |PgUp |  n  |  n  |
            // |  n  |SUPER| ALT |CTRL |SHIFT| cut |  none |  none | home |  <  | dwn |  >  | end |  n  |
            // |  n  |  n  |prev | ||> |next | copy|               |  n   |undo |  n  |redo |  n  |  n  |
            //                    | ESC | TAB |SPCE|               |BSPC | --- | DEL |
            //
            // undo/redo/cut/copy/paste are sent as literal keyboard shortcuts
            // (Ctrl+Z/Y/X/C/V) rather than HID consumer "AC_*" codes, since most
            // apps (and Linux especially) only listen for the former. snd-/x/+ and
            // prev/||>/next stay as real consumer media keys, which are universally
            // supported.

            bindings = <
            &none &none    &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &kp LC(V) &none &none &none    &kp PG_DN &kp UP   &kp PG_UP &none   &none
            &none &kp LGUI &kp LALT     &kp LCTRL  &kp LSHFT    &kp LC(X) &none &none &kp HOME &kp LEFT  &kp DOWN &kp RIGHT &kp END &none
            &none &none    &kp C_PREV   &kp C_PP   &kp C_NEXT   &kp LC(C)             &none    &kp LC(Z) &none    &kp LC(Y) &none   &none
                                        &kp ESC    &kp TAB      &kp SPACE             &kp BSPC &none     &kp DEL
            >;
        };

        function_layer {
            display-name = "FUNC";

            // --------------------------------------------------------------------------------
            // |BTCLR|BT  5|BT  4|BT  3|BT  2|BT  1|  none |  none |  n  |  n  | F7 | F8 | F9 | F12|
            // | RGB |SUPER| ALT |CTRL |SHIFT|  n  |  none |  none |  n  |  n  | F4 | F5 | F6 | F11|
            // |  n  |  n  |  n  |  n  |  n  |  n  |               |  n  |  n  | F1 | F2 | F3 | F10|
            //                   | --- | TAB |SPACE|               |BSPCE|ENTER| DEL|

            bindings = <
            &bt BT_CLR      &bt BT_SEL 4 &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0 &none &none &none    &none   &kp F7  &kp F8 &kp F9 &kp F12
            &rgb_ug RGB_TOG &kp LGUI     &kp LALT     &kp LCTRL    &kp LSHFT    &none        &none &none &none    &none   &kp F4  &kp F5 &kp F6 &kp F11
            &none           &none        &none        &none        &none        &none                    &none    &none   &kp F1  &kp F2 &kp F3 &kp F10
                                                      &none        &kp TAB      &kp SPACE                &kp BSPC &kp RET &kp DEL
            >;
        };

        diacritics_layer {
            display-name = "hats & dots";

            // --------------------------------------------------------------------------------
            // |  n  |  n  |  æ  |  ô  |  œ  |  n  |  none |  none |  n  |  n  |  n  |  n  |  n  |  n  |
            // |  n  |  â  | î/ï | ê/ë | û/ü |  n  |  none |  none |  n  |RSHFT|  n  |RALT |  n  |  n  |
            // |  n  |  n  | y/ÿ |  n  |  n  |  n  |               |  n  |  n  |  n  |  n  |  n  |  n  |
            //                   | ESC | TAB |SPACE|               |BSPC |ENTER| DEL |

            bindings = <
            &none &none                  &uc UC_FR_AE &uc UC_FR_O_CIRCUMFLEX &uc UC_FR_OE &none     &none &none &none    &none     &none   &none    &none &none
            &none &uc UC_FR_A_CIRCUMFLEX &i_hat       &e_hat                 &u_hat       &none     &none &none &none    &kp RSHFT &none   &kp RALT &none &none
            &none &none                  &y_trema     &none                  &none        &none                 &none    &none     &none   &none    &none &none
                                                      &kp ESC                &kp TAB      &kp SPACE             &kp BSPC &kp RET   &kp DEL
            >;
        };

        accent_layer {
            display-name = "ACCENT";

            // Type a base letter normally, then hold Del (right thumb) and tap one of
            // these. Two ways to compose an accent:
            //  - Letter positions (J/O/é/A/I/E/U/S/Y/W/G/H/Z) give the single precomposed
            //    Unicode character directly (â, ĵ, ŷ...) -- only the 13 Latin letters that
            //    actually have one exist here (verified against unicodedata); the other 13
            //    have no precomposed circumflex form in Unicode, full stop. 8 of these 12
            //    (A/E/H/I/O/U/W/Y) also have a precomposed diaeresis, so those are alt-tap
            //    mod-morphs (tap circumflex, alt diaeresis) instead of plain keys, same
            //    pattern as e_hat/i_hat/u_hat on the Diacritics layer -- in fact E/I/U here
            //    just reuse those exact behaviors. G/J/S/Z have no diaeresis codepoint
            //    either, so they stay plain circumflex-only.
            //  - The 6 remaining keys are combining marks (U+0300 block) that fuse onto
            //    whatever letter you just typed, so they work on literally any letter,
            //    including the 13 with no precomposed circumflex, e.g. n + circumflex(é
            //    position) -> n̂. Not in zmk-unicode's generated headers, so defined by
            //    hand as raw codepoints.
            // If it earns its keep over the N-key Diacritics layer, that one may retire.
            //
            // U/T hold Shift (left/right) and I/R hold Alt (left/right) -- same physical
            // spots as the default and Greek layers -- so Shift is actually reachable here
            // to get the caron/tilde/diaeresis shift-variants above and uppercase letters
            // (the &uc behavior itself picks upper/lowercase off currently-held Shift).
            // U and I keep their tap output (u_hat/i_hat); T and R had nothing bound, so
            // they're plain modifier keys.
            //
            // --------------------------------------------------------------------------------
            // |  n  |  n   |  ĵ  | ô/ö | ^/ˇ  |  n  |  none |  none |  n  |  n  |  n  |  `  |  n  |  n  |
            // |  n  |  â/ä | î/ï⌥| ê/ë |û/ü⇧  |  ´  |  none |  none |  n  |  ⇧  | ŝ   |  ⌥  |  n  |  n  |
            // | ¯/~ |  n   | ŷ/ÿ |  n  | ˙/¨  | ŵ/ẅ |               | ĝ   |  ¸  |  n  | ĥ/ḧ |  n  |  ẑ  |
            //                    | ESC | TAB  |SPACE|               |BSPC |ENTER| --- |

            bindings = <
            &none             &none             &uc UC_J_CIRCUMFLEX &o_hat  &acc_circumflex_caron &none             &none &none &none               &none               &none               &uc UC_COMB_GRAVE &none &none
            &none             &acc_hm_u LSHFT 0 &acc_hm_i LALT 0    &e_hat  &u_hat                &uc UC_COMB_ACUTE &none &none &none               &kp RSHFT           &uc UC_S_CIRCUMFLEX &kp RALT          &none &none
            &acc_macron_tilde &none             &y_hat              &none   &acc_dot_diaeresis    &w_hat                        &uc UC_G_CIRCUMFLEX &uc UC_COMB_CEDILLA &none               &h_hat            &none &uc UC_Z_CIRCUMFLEX
                                                                    &kp ESC &kp TAB               &kp SPACE                     &kp BSPC            &kp RET             &none
            >;
        };

    };
};
